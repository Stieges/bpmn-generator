{
  "name": "bpmn-generator",
  "version": "3.6.0",
  "description": "Enterprise BPMN 2.0 Generator — JSON Logic-Core → ElkJS Layout → OMG-compliant XML + SVG",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Stiegler",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stieges/bpmn-generator.git"
  },
  "keywords": [
    "bpmn",
    "bpmn2",
    "process",
    "diagram",
    "workflow",
    "elkjs",
    "layout",
    "svg",
    "xml",
    "omg",
    "modeler"
  ],
  "main": "pipeline.js",
  "files": [
    "*.js",
    "config.json",
    "agents/",
    "robustness/",
    "references/",
    "!**/*.test.js"
  ],
  "exports": {
    ".": "./pipeline.js",
    "./import": "./import.js",
    "./validate": "./validate.js",
    "./orchestrator": "./orchestrator.js"
  },
  "scripts": {
    "generate": "node pipeline.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --no-cache",
    "docs-gate": "node ../.github/scripts/docs-gate.mjs",
    "build:skill": "node build-skill.mjs",
    "demo": "AUDIT_LOG_PATH=./audit/bpmn-generator.jsonl node http-server.js",
    "prepack": "node prepack-copy-references.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bpmn-moddle": "^10.0.0",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "bpmn-auto-layout": "^1.3.0",
    "jest": "^30.4.2"
  }
}
