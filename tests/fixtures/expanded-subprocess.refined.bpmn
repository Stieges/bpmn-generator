    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="task1" />
    <bpmn:sequenceFlow id="f2" sourceRef="task1" targetRef="sub1" />
    <bpmn:sequenceFlow id="f3" sourceRef="sub1" targetRef="end1" />
