      <bpmn:incoming>f2c</bpmn:incoming>
      <bpmn:incoming>f2d</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="b1" name="Validate Request">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c1" name="Deploy Build">
