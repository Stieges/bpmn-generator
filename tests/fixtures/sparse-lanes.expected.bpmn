  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process_Sparse" name="Sparse Lanes Test" processRef="Process_Sparse" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Sparse" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Sparse">
