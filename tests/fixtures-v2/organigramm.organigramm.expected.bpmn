  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process_Bestellung" name="Bestellung abwickeln" processRef="Process_Bestellung" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bestellung" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Bestellung">
      <bpmn:lane id="L.Process_Bestellung.bereich_beschaffung" name="Beschaffung">
        <bpmn:extensionElements>
          <bg:derived by="unit" actor="bereich_beschaffung">lane</bg:derived>
        </bpmn:extensionElements>
        <bpmn:childLaneSet>
          <bpmn:lane id="L.Process_Bestellung.abt_einkauf" name="Einkauf">
            <bpmn:extensionElements>
              <bg:derived by="unit" actor="abt_einkauf">lane</bg:derived>
            </bpmn:extensionElements>
            <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>pruefen</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>gw</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="L.Process_Bestellung.bereich_beschaffung._own" name="Beschaffung">
            <bpmn:extensionElements>
              <bg:derived by="unit" actor="bereich_beschaffung">lane</bg:derived>
            </bpmn:extensionElements>
            <bpmn:flowNodeRef>rueck</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="L.Process_Bestellung.abt_buchhaltung" name="Buchhaltung">
        <bpmn:extensionElements>
          <bg:derived by="unit" actor="abt_buchhaltung">lane</bg:derived>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>zahlen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Bestellung eingegangen">
      <bpmn:outgoing>flow_start_pruefen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="pruefen" name="Auftrag prüfen">
      <bpmn:extensionElements>
        <bg:assignment type="D" actor="sb_einkauf" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_start_pruefen</bpmn:incoming>
      <bpmn:outgoing>flow_pruefen_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw" name="Rückfrage nötig?" gatewayDirection="Diverging" default="flow_gw_zahlen">
      <bpmn:incoming>flow_pruefen_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_rueck</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_zahlen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rueck" name="Lieferant klären">
      <bpmn:extensionElements>
        <bg:assignment type="D" actor="leitung" />
        <bg:assignment type="I" actor="sb_einkauf" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_gw_rueck</bpmn:incoming>
      <bpmn:outgoing>flow_rueck_zahlen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="zahlen" name="Zahlung anweisen">
      <bpmn:extensionElements>
        <bg:assignment type="D" actor="zahlung" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_gw_zahlen</bpmn:incoming>
      <bpmn:incoming>flow_rueck_zahlen</bpmn:incoming>
      <bpmn:outgoing>flow_zahlen_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Auftrag erledigt">
      <bpmn:incoming>flow_zahlen_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_pruefen" sourceRef="start" targetRef="pruefen" />
    <bpmn:sequenceFlow id="flow_pruefen_gw" sourceRef="pruefen" targetRef="gw" />
    <bpmn:sequenceFlow id="flow_gw_rueck" name="ja" sourceRef="gw" targetRef="rueck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gw_zahlen" name="nein" sourceRef="gw" targetRef="zahlen" />
    <bpmn:sequenceFlow id="flow_rueck_zahlen" sourceRef="rueck" targetRef="zahlen" />
    <bpmn:sequenceFlow id="flow_zahlen_end" sourceRef="zahlen" targetRef="end" />
  </bpmn:process>
