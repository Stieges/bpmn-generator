      <bpmn:incoming>flow_start_pruefen</bpmn:incoming>
      <bpmn:outgoing>flow_pruefen_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw" name="Regress möglich?" gatewayDirection="Diverging" default="flow_gw_zahlen">
