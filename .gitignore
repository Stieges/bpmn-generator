node_modules/
*.bpmn
*.svg
!references/**
!tests/**
!docs/**

# OMG spec files (keep locally, download links in omg-compliance.md).
# The four DMN 1.3 XSD schemas are tracked (39,237 B total, needed by the XSD
# validation test in scripts/dmn/dmn-xml.test.js) — everything else (PDFs,
# CMOF, informative examples, ~136 MB) stays out.
references/omg-spec/*
!references/omg-spec/normative
references/omg-spec/normative/*
!references/omg-spec/normative/dmn
references/omg-spec/normative/dmn/*
!references/omg-spec/normative/dmn/DMN13.xsd
!references/omg-spec/normative/dmn/DMNDI13.xsd
!references/omg-spec/normative/dmn/DC.xsd
!references/omg-spec/normative/dmn/DI.xsd

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Tooling artifacts
.playwright-mcp/

# Environment
.env
.env.*

# Runtime artifacts
audit/
dead-letter/

# Skill bundle (rebuild on demand via `npm run build:skill`)
bpmn-generator-v3.skill

# Robustness run artifacts (the dir is committed via .gitkeep, but reports are local)
tests/robustness-reports/*.md
tests/robustness-reports/*.json

# Handoff specs for external LLM sessions (local-only, kept on developer machines
# to be handed to opencode / Cursor / other agents — not project history)
docs/specs/

# Frontend (built by external LLM session per docs/specs/2026-05-18-bpmn-copilot-frontend.md,
# stays local per-developer machine — not project history)
frontend/

# Jest coverage output (generated by `npm test -- --coverage`)
scripts/coverage/

# Build artifact: prepack-copy-references.mjs copies these in from references/
# so the npm package can ship them. references/ (repo root) is the source.
scripts/references/
