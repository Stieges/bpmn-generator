{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-generator.local/catalog.schema.json",
  "title": "Actor and system catalogue",
  "description": "The catalogue of actors (roles, units), of systems (`systems`, format 2.1; actors and systems share one id space) and the responsibility scheme a 2.x model refers to. Design 5.2 and 5.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["actors"],
  "properties": {
    "actors": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/Actor" } },
    "systems": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/System" } },
    "scheme": { "$ref": "#/$defs/SchemeRef" },
    "description": { "type": "string", "maxLength": 1000 }
  },
  "$defs": {
    "ActorId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/ActorId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["role", "unit"] },
        "unit": { "$ref": "#/$defs/ActorId" },
        "partOf": { "$ref": "#/$defs/ActorId" }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "unit" } } },
          "then": { "properties": { "unit": false } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "role" } } },
          "then": { "properties": { "partOf": false } }
        }
      ]
    },
    "System": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/ActorId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "SchemeName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "SchemeKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,7}$" },
    "SchemeRef": {
      "if": { "type": "string" },
      "then": { "$ref": "#/$defs/SchemeName" },
      "else": { "$ref": "#/$defs/Scheme" }
    },
    "Scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "types"],
      "properties": {
        "scheme": { "$ref": "#/$defs/SchemeName" },
        "types": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/SchemeType" } }
      }
    },
    "SchemeType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/SchemeKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "performs": { "const": true }
      }
    }
  }
}
