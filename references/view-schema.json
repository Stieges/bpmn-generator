{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stieges.github.io/bpmn-generator/view-schema.json",
  "title": "View",
  "description": "A view: a small named file that decides how a model is processed (which rule profile, which layout switches, which derivations). It lives outside the model. Every view passes this gate (scripts/shared/view.js) before anything reads it; unknown keys are refused at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["view", "version"],
  "properties": {
    "view": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "const": "1.0" },
    "description": { "type": "string", "maxLength": 1000 },
    "ruleProfile": {
      "description": "A rule profile NAME (resolved inside rules/), never a path.",
      "type": "string",
      "pattern": "^(custom/)?[a-z0-9][a-z0-9-]{0,63}$"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bendRule": { "type": "boolean" },
        "nodeLabelsAvoidFlows": { "type": "boolean" },
        "foreignShapeRepair": { "type": "boolean" },
        "alignParticipantPorts": { "type": "boolean" },
        "visualRefinement": {
          "oneOf": [
            { "type": "boolean" },
            {
              "description": "Mirrors VisualRefinementOption in references/api-schema.json.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "laneCompaction": { "type": "boolean" },
                "edgeLabelCollisionRepair": { "type": "boolean" }
              }
            }
          ]
        },
        "poolOrder": { "enum": ["auto", "declared"] },
        "elkWrapping": { "enum": ["off", "auto", "always"] }
      }
    },
    "lanes": {
      "description": "Lanes formed from the assignments of a format 2.0 model: per performer (role), per unit of the performer (unit) or none; or the object form, which takes the units further: `level` counts the organigram (partOf) from the top, 1 = units without partOf, and `nested` draws sub-units as lanes inside their parent. Absent: a 1.x model keeps its own lanes, a 2.0 model gets role lanes. On a 1.x model a view with lanes is refused.",
      "oneOf": [
        { "enum": ["role", "unit", "none"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by"],
          "properties": {
            "by": { "const": "unit" },
            "level": { "type": "integer", "minimum": 1, "maximum": 16 },
            "nested": { "type": "boolean" }
          }
        }
      ]
    },
    "derivations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "joinGateways": { "type": "boolean" }
      }
    }
  }
}
